{
  "openapi": "3.0.3",
  "info": {
    "title": "学习计划系统 · 实验二接口",
    "version": "1.0.0",
    "description": "按现有 Controller、Entity、Result 与数据库字段核对。范围为实验二使用的登录及学习计划接口，不代表全部系统 API。"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地 Spring Boot 后端"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "注册普通用户",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "业务成功或失败均可能为 HTTP 200；必须检查 success。成功时返回用户，注册不会自动建立登录 Session。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResult"
                }
              }
            }
          },
          "400": {
            "description": "无效 JSON 或参数；不保证 Result 结构"
          },
          "403": {
            "description": "来源不在 CORS 白名单，可能是纯文本响应"
          },
          "500": {
            "description": "数据库或其他未处理错误；不保证 Result 结构"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "已有账号登录",
        "responses": {
          "200": {
            "description": "业务成功或失败均可能为 HTTP 200；必须检查 success。成功时建立 Session 并通过 JSESSIONID Cookie 维持登录。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResult"
                }
              }
            }
          },
          "400": {
            "description": "无效 JSON、日期或参数；不保证 Result 结构"
          },
          "403": {
            "description": "来源不在 CORS 白名单，可能是纯文本响应"
          },
          "500": {
            "description": "数据库或其他未处理错误；不保证 Result 结构"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        }
      }
    },
    "/api/auth/current": {
      "get": {
        "summary": "读取当前登录用户",
        "responses": {
          "200": {
            "description": "业务成功或失败均可能为 HTTP 200；必须检查 success。未登录时 success=true 且 data=null。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResult"
                }
              }
            }
          },
          "400": {
            "description": "无效 JSON、日期或参数；不保证 Result 结构"
          },
          "403": {
            "description": "来源不在 CORS 白名单，可能是纯文本响应"
          },
          "500": {
            "description": "数据库或其他未处理错误；不保证 Result 结构"
          }
        },
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "退出登录",
        "responses": {
          "200": {
            "description": "业务成功或失败均可能为 HTTP 200；必须检查 success。使 Session 失效，data=null。",
            "content": {
              "application/json": {
                "schema": {

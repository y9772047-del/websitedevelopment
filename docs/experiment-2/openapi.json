  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "RegistrationInput": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50
          },
          "realName": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 100
          }
        },
        "description": "Vue 注册页只提交这三个字段；角色和状态由后端注册逻辑决定。"
      },
      "PlanInput": {
        "type": "object",
        "required": [
          "planName"
        ],
        "properties": {
          "planName": {
            "type": "string",
            "description": "非空名称。数据库最大 100 字符；后端当前仅检查非空。"
          },
          "goal": {
            "type": "string",
            "nullable": true,
            "description": "数据库最大 255 字符"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "status": {
            "type": "string",
            "nullable": true,
            "description": "界面固定选项：未开始、进行中、已完成、已取消；现有后端未限定枚举。"
          }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "planName": {
            "type": "string",
            "description": "非空名称。数据库最大 100 字符；后端当前仅检查非空。"
          },
          "goal": {
            "type": "string",
            "nullable": true,
            "description": "数据库最大 255 字符"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "status": {
            "type": "string",
            "nullable": true,

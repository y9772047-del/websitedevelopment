    "/api/tasks": {
      "get": {
        "summary": "查询当前用户的任务",
        "parameters": [
          {
            "name": "planId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Q0",
                "Q1",
                "Q2",
                "Q3"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "只返回当前用户的数据；计划详情使用 planId 过滤并只读展示。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResult"
                }
              }
            }
          },
          "400": {
            "description": "日期或优先级无效；不保证 Result 结构"
          },
          "401": {
            "description": "未登录，返回 Result，success=false、data=null"
          },
          "403": {
            "description": "来源不在 CORS 白名单，可能是纯文本响应"
          },
          "500": {
            "description": "数据库或其他未处理错误；不保证 Result 结构"

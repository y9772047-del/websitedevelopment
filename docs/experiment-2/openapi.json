              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "必须检查 success。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResult"
                }
              }
            }
          },
          "401": {
            "description": "未登录，返回 success=false"
          },
          "403": {
            "description": "来源不在 CORS 白名单"
          },
          "500": {
            "description": "未处理的服务端错误"
          }
        }
      }
    },
